VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Supabase server-side environment (Edge Functions / admin scripts only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# M-Pesa Daraja (server-side only; do not expose in Vite env)
MPESA_ENV=sandbox
MPESA_PRODUCTION_ENABLED=false
MPESA_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.example
MPESA_MERCHANT_CONFIG_CONFIRMED=false
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PARTY_B=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_BASE_URL=https://your-project.supabase.co/functions/v1
MPESA_CALLBACK_TOKEN=replace-with-a-random-callback-token
MPESA_ACCOUNT_REFERENCE=DarkNode
MPESA_MIN_AMOUNT_KES=1
MPESA_MAX_AMOUNT_KES=150000
MPESA_USER_HOURLY_REQUEST_LIMIT=3
MPESA_B2C_ENABLED=false
MPESA_B2C_APPROVAL_CONFIRMED=false
MPESA_B2C_SHORTCODE=your-approved-b2c-shortcode
MPESA_INITIATOR_NAME=your-b2c-initiator-name
MPESA_SECURITY_CREDENTIAL=your-encrypted-b2c-security-credential
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_TOKEN=replace-with-a-random-result-token
MPESA_B2C_TIMEOUT_TOKEN=replace-with-a-random-timeout-token
MPESA_MAX_WITHDRAWAL_KES=150000
MPESA_RECONCILIATION_ADMIN_USER_IDS=replace-with-admin-auth-user-uuid
